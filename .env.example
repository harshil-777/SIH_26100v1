POSTGRES_USER=gem
POSTGRES_PASSWORD=gem
POSTGRES_DB=gem_compliance

# Leave DATABASE_URL unset to use the Compose stack's own postgres service (self-contained).
# From the host (outside Docker) that database is at localhost:5433:
# DATABASE_URL=postgresql+asyncpg://gem:gem@localhost:5433/gem_compliance
# For Supabase, the direct connection or either pooler works (the transaction pooler on 6543
# included -- app/db/session.py gives every prepared statement a unique name):
# DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Integration tests only: a throwaway database whose name ends in "_test" (it is wiped and
# reseeded). Never point this at a shared database. See tests/integration/conftest.py.
# TEST_DATABASE_URL=postgresql+asyncpg://gem:gem@localhost:5433/gem_compliance_test

REDIS_URL=redis://localhost:6379/0

ADAPTER_MODE=mock
SEED_DATA_DIR=WORKING DOCUMENTS
STORAGE_DIR=storage

# OCR. Leave TESSERACT_CMD unset if tesseract is on PATH (the Docker image installs it);
# on Windows the default "C:\Program Files\Tesseract-OCR\tesseract.exe" is found automatically.
# TESSERACT_CMD=
MAX_UPLOAD_MB=10
OCR_MAX_PAGES=5

# Trained models (ml/), published to Hugging Face -- see ml/README.md. Off by default: turning
# this on downloads multi-hundred-MB models and imports torch/transformers on first use.
# ML_MODELS_ENABLED=true
ML_EXTRACTION_MODEL=HarshilDaGoat/gem-certificate-extractor
ML_RISK_MODEL=HarshilDaGoat/gem-bid-risk
ML_RECOMMENDATION_MODEL=HarshilDaGoat/gem-recommendation-writer
# ML_DEVICE=cpu
